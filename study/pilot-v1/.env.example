# Copy this file to .env before starting the study.
#
# Keep this file free of real secrets. Put participant-specific values in .env.

USER_NAME="Participant 01"
MODEL_NAME="gpt-4o-mini"

# Preferred for OpenAI-hosted models.
OPENAI_API_KEY="paste-study-api-key-here"

# Optional: use an OpenAI-compatible model endpoint instead.
# GUM_LM_API_BASE="https://your-model-endpoint.example/v1"
# GUM_LM_API_KEY="paste-endpoint-key-here"

# Store each participant's data in a clearly named local folder.
GUM_DATA_DIR="$HOME/.cache/gum-pilot-v1-participant-01"

# Lower values make preliminary studies produce queryable data sooner.
MIN_BATCH_SIZE=3
MAX_BATCH_SIZE=8
